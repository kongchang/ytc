rules_version = '2';

// วิธีใช้ไฟล์นี้:
// Firebase Console > Firestore Database > แท็บ "Rules" > ลบของเดิมทั้งหมด
// แล้ววางโค้ดด้านล่างนี้แทน จากนั้นกด "Publish"

service cloud.firestore {
  match /databases/{database}/documents {

    match /complaints/{complaintId} {
      // อนุญาตให้อ่าน/เขียนได้เฉพาะผู้ที่ล็อกอินผ่าน Firebase Authentication แล้วเท่านั้น
      // (ปิดช่องที่คนนอกเคยเข้าถึงฐานข้อมูลได้ตรง ๆ โดยไม่ต้องผ่านหน้า Login เลย)
      allow read, write: if request.auth != null;
    }

    // ปิดกั้นทุก collection อื่นที่ไม่ได้ระบุไว้ข้างบนโดยปริยาย (deny by default)
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
